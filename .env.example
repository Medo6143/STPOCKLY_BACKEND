# Stockly local environment. Copy to .env (git-ignored) and replace every change-me value.
#   cp .env.example .env
# Never commit .env. Never put real secrets in this file (AGENTS.md rule 11).

# ---------------------------------------------------------------------------
# Docker Compose: PostgreSQL 16
# ---------------------------------------------------------------------------
POSTGRES_DB=stockly
POSTGRES_USER=stockly
POSTGRES_PASSWORD=change-me-postgres
# Optional host port (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Docker Compose: Redis 7 (cache only, no persistence)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Docker Compose: MinIO (local S3, dev/test only, ADR-0008)
# ---------------------------------------------------------------------------
# Root (admin) account. Used only by minio-init and the MinIO console. Password: 8+ characters.
MINIO_ROOT_USER=change-me-minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root-password
# Private bucket for invoice images. minio-init creates it.
MINIO_BUCKET=stockly-invoices
# Least-privilege API user that minio-init creates: Get/Put/DeleteObject on the bucket's
# objects and ListBucket on the bucket, nothing else. Secret key: 8+ characters.
STORAGE_ACCESS_KEY=change-me-api-user
STORAGE_SECRET_KEY=change-me-api-user-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Docker Compose: pgAdmin (only with --profile dev, but always required by compose)
# ---------------------------------------------------------------------------
# pgAdmin rejects .local email domains, so use a normal-looking address.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
PGADMIN_PORT=5050

# ---------------------------------------------------------------------------
# Stockly.Api: used from step 1.4 (how the API loads these is decided in 1.4)
# Values must match the compose settings above. Use 127.0.0.1, not localhost: compose binds IPv4 only, and
# "localhost" can resolve to ::1 first (Redis then times out and /health/ready reports Degraded).
# ---------------------------------------------------------------------------
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=stockly;Username=stockly;Password=change-me-postgres
ConnectionStrings__Redis=127.0.0.1:6379,password=change-me-redis,abortConnect=false
Storage__Endpoint=http://127.0.0.1:9000
# The least-privilege API user above, never the MinIO root account.
Storage__AccessKey=change-me-api-user
Storage__SecretKey=change-me-api-user-secret
Storage__Bucket=stockly-invoices
# JWT access tokens (HMAC-SHA256). The signing key is required: at least 32 bytes of random data
# (e.g. `openssl rand -base64 48`). Startup fails naming Jwt__SigningKey when it is missing or too short.
Jwt__SigningKey=change-me-jwt-signing-key-at-least-32-bytes-long
# Optional; these are the defaults.
Jwt__Issuer=stockly
Jwt__Audience=stockly-app
OpenRouter__ApiKey=change-me-openrouter-key
