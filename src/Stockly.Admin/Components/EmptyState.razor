<div class="d-flex flex-column align-center justify-center pa-10 text-center" data-testid="state-empty">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Primary" Class="mb-3" Style="font-size: 3rem; opacity: 0.6" />
    <MudText Typo="Typo.h6">@Title</MudText>
    @if (Text is not null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@Text</MudText>
    }
    @if (ChildContent is not null)
    {
        <div class="mt-4">@ChildContent</div>
    }
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Rounded.Inbox;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
