@page "/plans"
@attribute [Authorize]
@inherits ApiPageBase
@inject AdminApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Plans · Stockly Admin</PageTitle>

<PageHeader Title="Plans" Subtitle="Subscription plans: monthly price, daily scan quota and members. Shops pay for one month at a time.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="CreateAsync"
                   data-testid="new-plan">New plan</MudButton>
    </Actions>
</PageHeader>

<MudPaper Elevation="0" Class="section-card pa-2">
    <StateView Loading="_plans is null && _problem is null" Problem="_problem" IsEmpty="_plans is { Count: 0 }" OnRetry="LoadAsync"
               EmptyIcon="@Icons.Material.Rounded.WorkspacePremium" EmptyTitle="No plans yet"
               EmptyText="Create the first plan to assign it to shops.">
        <MudTable T="PlanDto" Items="_plans" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" data-testid="plans-table">
            <HeaderContent>
                <MudTh>Plan</MudTh>
                <MudTh Style="text-align: right">Scans per day</MudTh>
                <MudTh Style="text-align: right">Max members</MudTh>
                <MudTh Style="text-align: right">Monthly price</MudTh>
                <MudTh>Status</MudTh>
                <MudTh />
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Plan">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.body2" Style="font-weight: 600">@context.Name</MudText>
                        @if (IsFree(context))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" data-testid="plan-free">Free</MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mono">@context.Code</MudText>
                </MudTd>
                <MudTd DataLabel="Scans per day" Style="text-align: right">@Display.Count(context.DailyScanQuota)</MudTd>
                <MudTd DataLabel="Max members" Style="text-align: right">@Display.Count(context.MaxMembers)</MudTd>
                <MudTd DataLabel="Monthly price" Style="text-align: right">
                    <MudText Typo="Typo.h6" Class="mono" Color="@(IsFree(context) ? Color.Default : Color.Primary)" data-testid="plan-price">
                        @(IsFree(context) ? "Free" : Display.Egp(context.MonthlyPrice))
                    </MudText>
                    @if (!IsFree(context))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">per month</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
                </MudTd>
                <MudTd Style="text-align: right">
                    <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" aria-label="Edit plan"
                                   OnClick="() => EditAsync(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </StateView>
</MudPaper>

@code {
    private IReadOnlyList<PlanDto>? _plans;
    private ApiProblem? _problem;

    protected override Task OnInitializedAsync() => LoadAsync();

    // A plan with price 0 cannot be checked out by a shop (contract §12, Billing.FreePlan).
    private static bool IsFree(PlanDto plan) => Display.ParseDecimal(plan.MonthlyPrice) == 0m;

    private async Task LoadAsync()
    {
        _problem = null;
        _plans = null;
        var result = await Api.GetPlansAsync(PageToken);
        _plans = result.Value;
        _problem = result.Problem;
    }

    private Task CreateAsync() => OpenEditorAsync(null, "Plan created.");

    private Task EditAsync(PlanDto plan) => OpenEditorAsync(plan, "Plan saved.");

    private async Task OpenEditorAsync(PlanDto? plan, string success)
    {
        var parameters = new DialogParameters<PlanEditorDialog> { { dialog => dialog.Plan, plan } };
        var saved = await Dialogs.ShowAsync<PlanEditorDialog, PlanDto>(plan is null ? "New plan" : "Edit plan", parameters);
        if (saved is not null)
        {
            Snackbar.Add(success, Severity.Success);
            await LoadAsync();
        }
    }
}
