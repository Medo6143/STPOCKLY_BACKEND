<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Neutral resources (*.resx) are English; Arabic lives in *.ar.resx satellites. -->
    <NeutralLanguage>en</NeutralLanguage>
    <!--
      Thread-pool floor (runtimeconfig System.Threading.ThreadPool.MinThreads). Hangfire's enqueue in the scan request is
      synchronous database I/O; a burst of scans after an idle period blocked every pool thread and waited for the pool
      to grow (about one thread per 0.5 s): p95 of I1 22.6 s instead of 0.9 s. docs/operations/load-test.md.
    -->
    <ThreadPoolMinThreads>64</ThreadPoolMinThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <!-- Design-time only: lets `dotnet ef` use the Api as startup project (AGENTS.md §3). Never flows to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stockly.Application\Stockly.Application.csproj" />
    <ProjectReference Include="..\Stockly.Infrastructure\Stockly.Infrastructure.csproj" />
    <ProjectReference Include="..\Stockly.Contracts\Stockly.Contracts.csproj" />
  </ItemGroup>

</Project>
