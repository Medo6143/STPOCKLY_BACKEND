<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      OpenAPI contract for stockly-mobile (ADR-0011): every local build writes docs/api/openapi.json.
      CI sets CI=true, so generation is skipped there and OpenApiContractTests compares the runtime
      document with the committed file.
    -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../docs/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocuments Condition="'$(CI)' == 'true'">false</OpenApiGenerateDocuments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <!-- Design-time only: lets `dotnet ef` use the Api as startup project (AGENTS.md §3). Never flows to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stockly.Application\Stockly.Application.csproj" />
    <ProjectReference Include="..\Stockly.Infrastructure\Stockly.Infrastructure.csproj" />
    <ProjectReference Include="..\Stockly.Contracts\Stockly.Contracts.csproj" />
  </ItemGroup>

</Project>
