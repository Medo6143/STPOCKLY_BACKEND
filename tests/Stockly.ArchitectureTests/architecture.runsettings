<?xml version="1.0" encoding="utf-8"?>
<!--
  Architecture tests read the IL of the src assemblies. Coverage instrumentation rewrites that IL and adds a
  dependency on coverlet's tracker, which makes the layer rules fail. Nothing is instrumented for this project.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Exclude>[*]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
